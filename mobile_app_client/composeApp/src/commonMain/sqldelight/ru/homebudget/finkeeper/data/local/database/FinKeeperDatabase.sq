incomeSourceExistsById:
SELECT EXISTS(SELECT 1 FROM income_sources WHERE id = ?);

incomeSourceExistsByServerId:
SELECT EXISTS(SELECT 1 FROM income_sources WHERE server_id = ?);

getIncomeSourceByServerId:
SELECT * FROM income_sources WHERE server_id = ?;

getFixedIncomeSourcesByUser:
