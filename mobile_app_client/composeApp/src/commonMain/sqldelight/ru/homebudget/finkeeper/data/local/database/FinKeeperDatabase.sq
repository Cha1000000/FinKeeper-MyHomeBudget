getIncomeSourcesPendingSync:
SELECT * FROM income_sources WHERE sync_status != 'synced';

getIncomeSourcesPendingSyncCount:
SELECT COUNT(*) FROM income_sources WHERE sync_status != 'synced';

getMaxIncomeSourceSortOrder:
