-- Sync Queue queries
insertSyncQueueItem:
INSERT INTO sync_queue (user_id, entity_type, entity_id, operation, payload, created_at, status)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateSyncQueueItemStatus:
UPDATE sync_queue SET status = ?, last_attempt = datetime('now'), retry_count = retry_count + 1, error_message = ? WHERE id = ?;

updateSyncQueueItemCompleted:
UPDATE sync_queue SET status = 'completed', last_attempt = datetime('now') WHERE id = ?;

deleteSyncQueueItemById:
DELETE FROM sync_queue WHERE id = ?;

deleteSyncQueueItemByIdAndType:
DELETE FROM sync_queue WHERE entity_type = ? AND entity_id = ?;

deleteAllSyncQueueItemsByUser:
DELETE FROM sync_queue WHERE user_id = ?;

getSyncQueueItemById:
SELECT * FROM sync_queue WHERE id = ?;

getPendingSyncQueueItems:
SELECT * FROM sync_queue WHERE status = 'pending' ORDER BY created_at ASC LIMIT :limit;

getFailedSyncQueueItems:
SELECT * FROM sync_queue WHERE status = 'failed' ORDER BY last_attempt ASC LIMIT :limit;

getAllSyncQueueItemsByUser:
SELECT * FROM sync_queue WHERE user_id = ? ORDER BY created_at DESC;

getSyncQueueItemCount:
SELECT COUNT(*) FROM sync_queue WHERE status = 'pending';

syncQueueItemExists:
SELECT EXISTS(SELECT 1 FROM sync_queue WHERE entity_type = ? AND entity_id = ? AND status = 'pending');

deleteAllSyncQueueItems:
DELETE FROM sync_queue;

clearCompletedSyncQueueItems:
DELETE FROM sync_queue WHERE status = 'completed';

-- Retry failed operations
updateFailedToPending:
UPDATE sync_queue SET status = 'pending', error_message = NULL WHERE status = 'failed';

-- Get total income for month
getTotalIncomeByMonth:
SELECT COALESCE(SUM(amount), 0) AS value FROM incomes WHERE month_id = ?;

-- Get total income for month by source
getTotalIncomeByMonthAndSource:
SELECT COALESCE(SUM(amount), 0) AS value FROM incomes WHERE month_id = ? AND income_source_id = ?;

-- Get visible expenses for month
getVisibleExpensesByMonth:
SELECT * FROM expenses WHERE month_id = ? AND is_hidden = 0 ORDER BY date DESC;

-- Get expenses by month and category
getExpensesByMonthAndCategory:
SELECT * FROM expenses WHERE month_id = ? AND category_id = ? ORDER BY date DESC;

-- Get total expense for month
getTotalExpenseByMonth:
SELECT COALESCE(SUM(amount), 0) FROM expenses WHERE month_id = ?;

-- Get total expense for month by category
getTotalExpenseByMonthAndCategory:
SELECT COALESCE(SUM(amount), 0) FROM expenses WHERE month_id = ? AND category_id = ?;

-- Get total visible expense for month
getTotalVisibleExpenseByMonth:
SELECT COALESCE(SUM(amount), 0) FROM expenses WHERE month_id = ? AND is_hidden = 0;

-- Get last insert row ID
lastInsertRowId:
SELECT last_insert_rowid();
